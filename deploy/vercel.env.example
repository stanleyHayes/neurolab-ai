# Set these as server-side Vercel project environment variables. Never commit values.
APP_ENV=production
MODEL_INFERENCE_ENABLED=false
RESEARCH_INLINE_WORKER=false
# Persistent PostgreSQL provisioned through Vercel Marketplace; SSL required by provider.
DATABASE_URL=
API_BEARER_TOKEN=
AUTH_ED25519_PRIVATE_KEY=
AUTH_ED25519_PREVIOUS_PUBLIC_KEYS={}
AUTH_JWT_KID=neurolab-vercel-v1
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=neurolab-web
AUTH_TOKEN_PEPPER=
AUTH_INVITE_CODE=
# Exact permitted hosts for the actual private service transport; verify in deployment.
ALLOWED_HOSTS=
RESEARCH_MAX_RUNNING_JOBS=2
# RESEARCH_API_URL is injected into web by the service binding. Do not set it manually.
# Do not upload Meta/provider keys: the Vercel profile intentionally strips them.
# Enable Vercel system environment variables for VERCEL_GIT_COMMIT_SHA provenance.
