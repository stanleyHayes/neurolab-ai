# URL used by the Next.js API proxy to reach the FastAPI research service.
RESEARCH_API_URL=http://127.0.0.1:8000
# Production only: set APP_ENV=production in both services. Generate a random
# 32+ character token and use the same value in both processes. Keep the FastAPI
# service on a private network; browser clients must never receive this token.
APP_ENV=development
API_BEARER_TOKEN=
# End-user authentication (API only; never NEXT_PUBLIC_*). Create a dedicated
# Ed25519 PKCS#8 PEM key and 32+ random-byte token pepper for production.
# Example key generation: openssl genpkey -algorithm ED25519 -out auth-ed25519.pem
AUTH_ED25519_PRIVATE_KEY=
AUTH_JWT_KID=neurolab-ed25519-2026-01
AUTH_JWT_ISSUER=https://neurolab.example
AUTH_JWT_AUDIENCE=neurolab-web
AUTH_TOKEN_PEPPER=
# Production registration is closed unless a strong invite code is configured.
# Registration remains invite-only when AUTH_INVITE_CODE is set in any mode.
AUTH_INVITE_CODE=
# Production only: comma-separated public API hostnames, with no wildcard.
ALLOWED_HOSTS=
# Copy to .env for the API process; never commit credentials.
META_MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Full HTTPS OpenAI-compatible chat-completions endpoint supplied by Meta/provider.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1/chat/completions
MODEL_PROVIDER=meta
# Set true only after scripts/smoke_meta_provider.py succeeds using real credentials.
META_MODEL_VERIFIED=false
MODEL_MAX_OUTPUT_TOKENS=2000
# Conservative per-run reservation budget; provider pricing/quota is still authoritative.
MODEL_MAX_RUN_TOKENS=16000
OPEN_WEIGHT_PROVIDER=
OPEN_WEIGHT_MODEL_ID=
MODEL_MAX_COST_USD=10
RESEARCH_MAX_STEPS=6
RESEARCH_MAX_TOOL_CALLS=10
# Local PostgreSQL via the default macOS Unix socket/user. For remote PostgreSQL use:
# postgresql://USER:PASSWORD@HOST:5432/neurolab
DATABASE_URL=postgresql:///neurolab

# Set false to block both new Meta runs and objective refinement; saved replay remains available.
MODEL_INFERENCE_ENABLED=true

# Persist requests and execute via the standalone SQL worker (recommended).
# API and worker must use the same DATABASE_URL and consistent limits.
RESEARCH_INLINE_WORKER=false
RESEARCH_MAX_QUEUED_JOBS=100
RESEARCH_MAX_RUNNING_JOBS=2
