# URL used by the Next.js API proxy to reach the FastAPI research service.
RESEARCH_API_URL=http://127.0.0.1:8000
# Production only: set APP_ENV=production in both services. Generate a random
# 32+ character token and use the same value in both processes. Keep the FastAPI
# service on a private network; browser clients must never receive this token.
APP_ENV=development
API_BEARER_TOKEN=
# Next server only: ingress must strip/replace this single-IP header. Blank means
# aggregate BFF-peer quotas; never trust an arbitrary browser/X-Forwarded-For value.
NEUROLAB_TRUSTED_CLIENT_IP_HEADER=
# FastAPI socket peers allowed to relay that identity with the service credential.
# Run Uvicorn --no-proxy-headers so ASGI client remains the transport peer.
NEUROLAB_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# End-user authentication (API only; never NEXT_PUBLIC_*). Create a dedicated
# Ed25519 PKCS#8 PEM key and 32+ random-byte token pepper for production.
# Example key generation: openssl genpkey -algorithm ED25519 -out auth-ed25519.pem
AUTH_ED25519_PRIVATE_KEY=
AUTH_JWT_KID=neurolab-ed25519-2026-01
# API-only JSON object of at most three explicitly trusted verify-only Ed25519
# public PEMs keyed by unique IDs; supports staged rollover. Never private PEMs.
AUTH_ED25519_PREVIOUS_PUBLIC_KEYS={}
AUTH_JWT_ISSUER=https://neurolab.example
AUTH_JWT_AUDIENCE=neurolab-web
AUTH_TOKEN_PEPPER=
# Production registration is closed unless a strong invite code is configured.
# Registration requires a matching private invite. Blank disables development signup;
# production startup requires a nonblank invite secret.
AUTH_INVITE_CODE=
# Production only: comma-separated public API hostnames, with no wildcard.
ALLOWED_HOSTS=
# Copy to .env for the API process; never commit credentials.
META_MODEL_API_KEY=
META_MODEL_ID=muse-spark-1.3
# Full HTTPS OpenAI-compatible chat-completions endpoint supplied by Meta/provider.
META_MODEL_API_BASE_URL=https://api.meta.ai/v1/chat/completions
MODEL_PROVIDER=meta
# Set true only after scripts/smoke_meta_provider.py succeeds using real credentials.
META_MODEL_VERIFIED=false
MODEL_MAX_OUTPUT_TOKENS=2000
# Conservative per-run reservation budget; provider pricing/quota is still authoritative.
MODEL_MAX_RUN_TOKENS=16000
OPEN_WEIGHT_PROVIDER=
OPEN_WEIGHT_MODEL_ID=
MODEL_MAX_COST_USD=10
# Required before any live call: operator-reviewed price ceilings for the exact
# configured provider/model/endpoint. Blank settings fail closed; no prices assumed.
MODEL_INPUT_USD_PER_MILLION_TOKENS=
MODEL_OUTPUT_USD_PER_MILLION_TOKENS=
MODEL_INPUT_OVERHEAD_TOKENS=
MODEL_OWNER_DAILY_COST_USD=
MODEL_GLOBAL_DAILY_COST_USD=
# Operator CLI smoke only: active local user ID charged against shared ceilings.
# Never accepted as a browser-supplied owner or used for ordinary research runs.
MODEL_SMOKE_OWNER_USER_ID=
RESEARCH_MAX_STEPS=6
RESEARCH_MAX_TOOL_CALLS=10
# Local PostgreSQL via the default macOS Unix socket/user. For remote PostgreSQL use:
# postgresql://USER:PASSWORD@HOST:5432/neurolab
DATABASE_URL=postgresql:///neurolab

# Set false to block both new Meta runs and objective refinement; saved replay remains available.
# Replay is the default while provider credits are exhausted.
MODEL_INFERENCE_ENABLED=false

# Persist requests and execute via the standalone SQL worker (recommended).
# API and worker must use the same DATABASE_URL and consistent limits.
RESEARCH_INLINE_WORKER=false
RESEARCH_MAX_QUEUED_JOBS=100
RESEARCH_MAX_RUNNING_JOBS=2

# --- Cloudflare R2 encrypted PostgreSQL backups (configuration only) ---
# Fill blank R2 fields from Cloudflare R2 > Manage API Tokens / bucket settings.
# Use bucket-scoped Object Read & Write credentials, not a global Cloudflare API key.
# No NEXT_PUBLIC_ prefix: these values belong only in the backend/backup runtime.
# Keep false until configuration and an encrypted restore test pass.
BACKUP_ENABLED=false
# Cloudflare account ID shown in the R2 dashboard.
R2_ACCOUNT_ID=
# Copy the bucket account S3 API endpoint, including https://.
R2_ENDPOINT_URL=
# Exact name of the existing private bucket.
R2_BUCKET_NAME=
# R2 S3 access key ID; scope access to this bucket.
R2_ACCESS_KEY_ID=
# Matching R2 S3 secret access key. Do not paste it into chat.
R2_SECRET_ACCESS_KEY=
# Only this application prefix will be used.
R2_BACKUP_PREFIX=neurolab/postgres/
# Leave blank if you want me to generate a fresh Fernet key securely.
BACKUP_ENCRYPTION_KEY=
# Proposed retention for NeuroLab backup objects; not active yet.
BACKUP_RETENTION_DAYS=30
# Proposed daily schedule at 02:00 UTC / Accra; not active yet.
BACKUP_SCHEDULE_UTC="0 2 * * *"
